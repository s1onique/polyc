# EXACTLY ONE FILE, EXACTLY ONE HUNK, EXACTLY ONE LINE.  The changed
# line is INSIDE the function parseCompoundBlockAppendsStatement, in
# the #else (legacy) arm.
#
# ------------------------------------------------------------------
# THE EXACT DIFF
# ------------------------------------------------------------------
#
diff --git a/src/parser.c b/src/parser.c
index 0033fdf..edcc497 100644
--- a/src/parser.c
+++ b/src/parser.c
@@ -1999,7 +1999,7 @@ static int parseCompoundBlockAppendsStatement(int stmt_kind, int declvar_kind)
      * Reachable only in non-HCC_USE_SELFHOST_PARSER_COMPOUND_BLOCK_APPEND
      * builds (the differential's slice07-parser-legacy.o).  Production
      * never executes this branch. */
-    if (stmt_kind == AST_DECL && declvar_kind == AST_GVAR) return 0;
+    if (stmt_kind == AST_DECL && declvar_kind == AST_GVAR) return 1;
     return 1;
 #endif
 }

