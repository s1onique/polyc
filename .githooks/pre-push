#!/bin/sh
# .githooks/pre-push
#
# Git invokes this hook with two positional arguments and a stream
# of ref updates on stdin:
#
#   $1 = name of destination remote (a configured remote name like
#        "origin", OR the URL itself when the user pushes to an
#        anonymous URL)
#   $2 = location of destination remote (always a URL)
#
# If the push uses a named remote, $1 is the remote name and $2 is
# its URL. If the push uses an unnamed URL, $1 == $2 (both are the
# URL). This is documented in githooks(5).
#
# On stdin, Git passes one line per ref update:
#
#   <local_ref> SP <local_sha> SP <remote_ref> SP <remote_sha> LF
#
# We validate the local side of every non-delete push by running
# scripts/quality/gate-push.sh against the local SHA in an isolated
# detached worktree.
#
# Implementation notes:
#
#   * We consume ALL stdin lines before deciding anything. Git's hook
#     contract requires this; otherwise Git can hang.
#   * Deletes (local_sha = 0000...0000) are NOT simply ignored;
#     the append-only guard for `refs/heads/main` MUST inspect
#     them before the per-ref hygiene loop skips them, otherwise
#     a real `git push origin :main` would bypass the guard.
#     See ACT-POLYC-FACTORY-APPEND-ONLY-GUARD01-CORRECTION01.
#   * Dedupe key is (local_sha, remote_sha, destination, mode), NOT
#     just local_sha. Git's contract permits the same local_sha to
#     appear with different remote_shas (existing-branch update +
#     new-branch push in the same push), and each combination
#     requires a different hygiene range. See
#     ACT-POLYC-FACTORY-PUSH-HERMETIC01-CORRECTION03 (P0-1).
#   * For new branches (remote_sha = 0000...0000), the hook passes
#     `--new-branch <destination>` to gate-push.sh so the gate
#     computes `reachable(local) \ reachable(<destination>'s
#     tracking refs)`. The destination is Git's $1 (the actual
#     remote the user pushed to), NOT the first configured remote.
#     See ACT-POLYC-FACTORY-PUSH-HERMETIC01-CORRECTION04.
#   * For anonymous URL pushes, $1 is the URL itself, which is not
#     a valid remote name for --remotes=<>. In that degenerate
#     case we fall back to --root-range (full reachable history)
#     and log POLYC_PRE_PUSH_NOTE. We do NOT guess a remote by
#     sorting `git remote` output.
#   * We do not invoke git commit/push from quality scripts, so no
#     recursive hook execution is possible.

set -eu

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

# --- ACT-POLYC-FACTORY-HISTORY-RECONCILE01 §20 ---
# --- ACT-POLYC-FACTORY-APPEND-ONLY-GUARD01 ---
# --- ACT-POLYC-FACTORY-APPEND-ONLY-GUARD01-CORRECTION01 ---
# Append-only enforcement for authoritative main. The hook
# enforces graph properties of the proposed ref transition,
# NOT a blacklist of `git push` command-line flags.
#
# 1. refuse to push if `git replace` namespace is non-empty
#    (no replacement objects are ever permitted);
# 2. refuse to delete `refs/heads/main` (delete-and-recreate
#    is the canonical rewrite bypass). Detected by
#    `remote_ref = refs/heads/main` AND
#    `local_sha = 0000...0000` (per githooks(5));
# 3. refuse any non-fast-forward update of
#    `refs/heads/main`. Detected by
#    `remote_ref = refs/heads/main` AND
#    `remote_sha != 0000...0000` AND
#    `!git merge-base --is-ancestor $remote_sha $local_sha`.
#
# CORRECTION01 rebinds the guard from `local_ref` to
# `remote_ref` (the authoritative ref is the destination,
# not the source), and from `remote_sha == ZERO` (which
# encodes "create", per githooks(5)) to `local_sha == ZERO`
# (which encodes "delete"). The closed hook's encoding was
# backwards on both axes; see
# ACT-POLYC-FACTORY-APPEND-ONLY-GUARD01-CORRECTION01 §Why.
#
# Topic branches are intentionally NOT policed by this ACT.
# The git-command-string blacklist approach (parsing
# `--force`, `+main`, etc.) is explicitly avoided because
# Git's pre-push hook contract gives us the resulting ref
# transition directly, which is both simpler and stronger.
if [ -n "$(git replace -l 2>/dev/null)" ]; then
    echo "POLYC_PRE_PUSH_HALTED=replace-namespace-non-empty"
    echo "REASON=git replace -l is non-empty; refuse to push."
    exit 1
fi

# Zero-SHA sentinel that Git uses for ref deletion.
ZERO_SHA=0000000000000000000000000000000000000000


# Read all stdin lines into memory up front.
stdin_lines=$(cat)

# Bind the destination remote from Git's documented pre-push hook
# contract. $1 is the destination remote NAME (or the URL when the
# push is to an unnamed URL); $2 is the destination URL. We must
# use $1 to determine which remote's tracking refs are relevant.
#
# CORRECTION04: do NOT derive this from `git remote | head -n1`.
# That picks whichever remote happens to sort first, which has no
# relation to the actual destination of this push.
destination_name="${1:-}"
destination_url="${2:-}"

# Detect an anonymous-URL push: per githooks(5), when the user does
# not use a named remote, both $1 and $2 are the URL and $1 == $2.
# In that case --new-branch can't bind a remote namespace and we
# must fall back to --root-range.
if [ -z "$destination_name" ]; then
    destination_kind="empty"
elif [ "$destination_name" = "$destination_url" ]; then
    destination_kind="anonymous"
else
    destination_kind="named"
fi

# Parse stdin once. For each ref update we compute a stable key
# (local_sha, remote_sha, destination, mode) and dedupe across the
# whole push, then call gate-push.sh for each unique combination.
seen_keys=""

while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
    # Skip empty lines.
    [ -z "$local_sha" ] && continue

    # --- ACT-POLYC-FACTORY-APPEND-ONLY-GUARD01-CORRECTION01 ---
    # Authoritative-main guard. Applies ONLY to updates whose
    # `remote_ref` is `refs/heads/main`, regardless of what
    # the local source ref name is. Per githooks(5):
    #
    #   * `git push origin :main`             -> delete
    #       local_ref  = (delete)
    #       local_sha  = 0000...0000
    #       remote_ref = refs/heads/main
    #       remote_sha = <existing remote tip>
    #
    #   * `git push origin feature:main`      -> feature -> main
    #       local_ref  = refs/heads/feature
    #       local_sha  = <feature tip>
    #       remote_ref = refs/heads/main
    #       remote_sha = <existing remote tip>
    #
    #   * `git push origin HEAD:main`         -> literal source
    #       local_ref  = HEAD  (literal, per githooks(5))
    #       remote_ref = refs/heads/main
    #
    # Rule 1: refuse to delete refs/heads/main. Deletion is
    # the all-zero `local_sha` shape (`(delete) ZERO
    # refs/heads/main <remote-tip>`). Detected by
    # `local_sha == 0000...`.
    #
    # Rule 2: refuse any non-fast-forward update of
    # refs/heads/main. We use `git merge-base --is-ancestor`
    # against the resulting transition: remote_sha must be
    # an ancestor of local_sha. The "remote has no main yet"
    # shape (`remote_sha == 0000...`) is a legitimate push
    # and is therefore NOT policed here -- it falls through
    # to the per-ref `gate-push.sh` validation just like any
    # other new-branch push.
    #
    # We do NOT parse `git push` arguments; we look at the
    # resulting ref transition, which is what matters. This
    # correction rebinds the guard from `local_ref` to
    # `remote_ref`, and from `remote_sha == ZERO` to
    # `local_sha == ZERO`, per the protocol.
    case "$remote_ref" in
        refs/heads/main)
            # Deletion: local_sha is the all-zero sentinel
            # (`(delete)` ref + ZERO sha is the protocol
            # shape; bare local_sha == ZERO would be
            # malformed input but we treat it the same way
            # because the only legitimate reason for a
            # zero local_sha here is a deletion).
            case "$local_sha" in
                "$ZERO_SHA")
                    echo "POLYC_PRE_PUSH_HALTED=main-deletion"
                    echo "REASON=authoritative main must not be deleted;"
                    echo "       refusing push (ACT-POLYC-FACTORY-APPEND-ONLY-GUARD01-CORRECTION01)."
                    exit 1
                    ;;
            esac
            # Update: only fire when the remote ALREADY has
            # a main tip to compare against. Creation of a
            # new remote main (remote_sha == ZERO) is left
            # alone.
            case "$remote_sha" in
                "$ZERO_SHA") ;;
                *)
                    if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
                        echo "POLYC_PRE_PUSH_HALTED=main-non-fast-forward"
                        echo "REASON=authoritative main transition is not a fast-forward;"
                        echo "       remote_ref=$remote_ref"
                        echo "       local_ref=$local_ref"
                        echo "       remote_sha=$(printf '%s' "$remote_sha" | cut -c1-12)"
                        echo "       local_sha=$(printf '%s' "$local_sha" | cut -c1-12)"
                        echo "       refusing push (ACT-POLYC-FACTORY-APPEND-ONLY-GUARD01-CORRECTION01)."
                        exit 1
                    fi
                    ;;
            esac
            ;;
    esac

    # Skip deletes (remote-only refs that have no local side)
    # AFTER the append-only guard has had a chance to inspect
    # them. The guard above is keyed on `remote_ref`, which is
    # set on every line including delete lines; without this
    # ordering, deletes of `refs/heads/main` would never reach
    # the guard. For all other refs, a delete has no local
    # SHA to validate, so we skip the rest of the loop.
    case "$local_sha" in
        0000000000000000000000000000000000000000) continue ;;
    esac

    # Validate SHA form (avoid garbage from malformed input).
    case "$local_sha" in
        [0-9a-f]*)
            ;;
        *)
            continue
            ;;
    esac


    # Determine the mode for this ref update.
    #
    # For an existing-branch push (remote_sha is a real commit), the
    # gate inspects remote_sha..local_sha. The dedupe key MUST include
    # remote_sha because the same local_sha can legitimately be pushed
    # to two refs with different remote_shas (existing narrow update
    # + new-branch introduction).
    #
    # For a new-branch push (remote_sha = 0000...0000), the gate
    # inspects reachable(local_sha) MINUS reachable(<remote>'s
    # tracking refs). The dedupe key includes the remote name for
    # the same reason: different remotes may have different
    # tracking-ref state.
    case "$remote_sha" in
        0000000000000000000000000000000000000000)
            mode="new-branch"
            case "$destination_kind" in
                named)
                    new_branch_remote="$destination_name"
                    new_branch_fallback=""
                    ;;
                *)
                    # anonymous or empty destination: no trustworthy
                    # remote-tracking namespace. Fall back to root
                    # range (full reachable history) so we at least
                    # catch inherited WS.
                    new_branch_remote=""
                    new_branch_fallback="root-range"
                    ;;
            esac
            dedupe_key="newbranch:${destination_kind}:${destination_name}:$local_sha"
            ;;
        *)
            mode="range"
            new_branch_remote=""
            new_branch_fallback=""
            dedupe_key="range:${remote_sha}:${destination_name}:$local_sha"
            ;;
    esac

    # De-duplicate on the full key, not just local_sha.
    case " $seen_keys " in
        *" $dedupe_key "*) continue ;;
    esac
    seen_keys="$seen_keys $dedupe_key"

    short=$(printf '%s' "$local_sha" | cut -c1-12)
    echo "POLYC_PRE_PUSH_VALIDATING=$short mode=$mode dest=$destination_kind"

    # Build the gate-push.sh command for this ref update.
    if [ "$mode" = "new-branch" ]; then
        if [ -n "$new_branch_fallback" ]; then
            # Degenerate fallback: no named destination (anonymous
            # URL push or no remote configured). Use --root-range
            # so the gate at least runs over the full reachable
            # history.
            echo "POLYC_PRE_PUSH_NOTE=$destination_kind destination ($destination_name); falling back to --root-range for $short"
            if ! ./scripts/quality/gate-push.sh \
                    "$local_sha" --root-range; then
                echo "POLYC_PRE_PUSH_HALTED_AT=$short"
                exit 1
            fi
        else
            # Named destination: pass it directly to --new-branch.
            if ! ./scripts/quality/gate-push.sh \
                    "$local_sha" --new-branch "$new_branch_remote"; then
                echo "POLYC_PRE_PUSH_HALTED_AT=$short"
                exit 1
            fi
        fi
    else
        # Range mode (existing-branch push).
        if ! ./scripts/quality/gate-push.sh \
                "$local_sha" "$remote_sha"; then
            echo "POLYC_PRE_PUSH_HALTED_AT=$short"
            exit 1
        fi
    fi
done << EOF
$stdin_lines
EOF

exit 0
